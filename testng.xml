<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="API Automation Suite">

    <listeners>

        <listener class-name="com.api.listeners.TestListener"/>

    </listeners>

    <test name="Booking Tests">

        <classes>

            <class name="com.api.tests.AuthTest"/>

            <class name="com.api.tests.AuthNegativeTest"/>

            <class name="com.api.tests.CreateBookingTest"/>

            <class name="com.api.tests.GetBookingTest"/>

            <class name="com.api.tests.CreateBookingDataDrivenTest"/>

            <class name="com.api.tests.GetBookingNegativeTest"/>

        </classes>

    </test>

</suite>